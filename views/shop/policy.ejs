<%- include('../partials/head') %>

<section class="section section-tight">
  <div class="container narrow">
    <nav class="crumbs"><a href="/"><%= t('home') %></a><span>/</span><span><%= title %></span></nav>
    <h1 class="page-title"><%= title %></h1>

    <div class="panel prose">
      <h2><%= t('payment') %></h2>
      <p><%= t('payment_text') %></p>
      <h2><%= t('returns') %></h2>
      <% for (const line of loc(settings, 'policy_text').split(/\r?\n/).filter(Boolean)) { %><p><%= line %></p><% } %>
    </div>

    <div class="panel">
      <h2><%= t('shipping_prices') %></h2>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th><%= t('wilaya') %></th><th><%= t('to_home') %></th><th><%= t('to_desk') %></th></tr></thead>
          <tbody>
            <% for (const w of wilayas) { %>
              <tr><td><%= String(w.code).padStart(2, '0') %> - <%= w.name %></td><td><%= price(w.home_price) %></td><td><%= price(w.desk_price) %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
