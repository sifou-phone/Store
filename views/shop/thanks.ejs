<%- include('../partials/head') %>

<section class="section">
  <div class="container narrow">
    <div class="thanks">
      <div class="thanks-icon"><%- icon('check') %></div>
      <h1>شكراً <%= order.customer_name %>!</h1>
      <p class="lead">تم استلام طلبك رقم <strong>#<%= order.id %></strong> بنجاح.<br>
        سنتصل بك قريباً على الرقم <strong dir="ltr"><%= order.phone %></strong> لتأكيد الطلب.</p>

      <div class="panel receipt">
        <% for (const it of items) { %>
          <div class="receipt-row">
            <span><%= it.name %><% if (it.variant) { %> <small>(<%= it.variant %>)</small><% } %> × <%= it.qty %></span>
            <span><%= price(it.price * it.qty) %></span>
          </div>
        <% } %>
        <div class="receipt-row muted"><span>التوصيل (<%= order.delivery_type === 'desk' ? 'مكتب التوصيل' : 'للمنزل' %> — <%= order.wilaya_name %>)</span><span><%= order.shipping ? price(order.shipping) : 'مجاني' %></span></div>
        <div class="receipt-row total"><span>المبلغ عند الاستلام</span><span><%= price(order.total) %></span></div>
      </div>

      <p class="muted">الرجاء إبقاء هاتفك مفتوحاً. عدم الرد على اتصال التأكيد قد يؤدي إلى إلغاء الطلب.</p>
      <div class="hero-actions center">
        <a class="btn btn-dark" href="/products">متابعة التسوق</a>
        <% if (waLink) { %><a class="btn btn-ghost" href="<%= waLink %>?text=<%= encodeURIComponent(`مرحباً، بخصوص طلبي رقم #${order.id}`) %>" target="_blank" rel="noopener"><%- icon('whatsapp') %>تواصل معنا</a><% } %>
      </div>
    </div>
  </div>
</section>
<script>try { if (sessionStorage.getItem('sp_clear_cart') === '1') { localStorage.removeItem('sp_cart'); sessionStorage.removeItem('sp_clear_cart'); } } catch (e) {}</script>
<% if (settings.fb_pixel_id) { %>
<script>
  (function () {
    var key = 'sp_px_<%= order.id %>';
    try { if (localStorage.getItem(key)) return; localStorage.setItem(key, '1'); } catch (e) {}
    fbq('track', 'Purchase', { value: <%= order.total %>, currency: 'DZD', content_type: 'product', content_ids: <%- json(items.map((i) => String(i.product_id))) %> });
  })();
</script>
<% } %>

<%- include('../partials/footer') %>
