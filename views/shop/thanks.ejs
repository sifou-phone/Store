<%- include('../partials/head') %>

<section class="section">
  <div class="container narrow">
    <div class="thanks">
      <div class="thanks-icon"><%- icon('check') %></div>
      <h1><%= t('thanks_hi', { name: order.customer_name }) %></h1>
      <p class="lead"><%= t('thanks_received', { id: '#' + order.id }) %><br>
        <%= t('thanks_call', { phone: order.phone }) %></p>

      <div class="panel receipt">
        <% for (const it of items) { %>
          <div class="receipt-row">
            <span><%= it.name %><% if (it.variant) { %> <small>(<%= it.variant %>)</small><% } %> × <%= it.qty %></span>
            <span><%= price(it.price * it.qty) %></span>
          </div>
        <% } %>
        <div class="receipt-row muted">
          <span><%= t('shipping_line', { type: order.delivery_type === 'desk' ? t('to_desk') : t('to_home'), wilaya: wilayaName }) %></span>
          <span><%= order.shipping ? price(order.shipping) : t('free') %></span>
        </div>
        <div class="receipt-row total"><span><%= t('amount_due') %></span><span><%= price(order.total) %></span></div>
      </div>

      <p class="muted"><%= t('keep_phone_on') %></p>
      <div class="hero-actions center">
        <a class="btn btn-dark" href="/products"><%= t('continue_shopping') %></a>
        <% if (waLink) { %><a class="btn btn-ghost" href="<%= waLink %>?text=<%= encodeURIComponent(t('wa_order_msg', { id: order.id })) %>" target="_blank" rel="noopener"><%- icon('whatsapp') %><%= t('contact_us') %></a><% } %>
      </div>
    </div>
  </div>
</section>
<script>try { if (sessionStorage.getItem('sp_clear_cart') === '1') { localStorage.removeItem('sp_cart'); sessionStorage.removeItem('sp_clear_cart'); } } catch (e) {}</script>
<% if (settings.fb_pixel_id) { %>
<script>
  (function () {
    var key = 'sp_px_<%= order.id %>';
    try { if (localStorage.getItem(key)) return; localStorage.setItem(key, '1'); } catch (e) {}
    fbq('track', 'Purchase', { value: <%= order.total %>, currency: 'DZD', content_type: 'product', content_ids: <%- json(items.map((i) => String(i.product_id))) %> });
  })();
</script>
<% } %>

<%- include('../partials/footer') %>
