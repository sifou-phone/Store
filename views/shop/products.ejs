<%- include('../partials/head') %>

<section class="section section-tight">
  <div class="container">
    <nav class="crumbs"><a href="/">الرئيسية</a><span>/</span><span><%= title %></span></nav>
    <div class="list-head">
      <h1><%= title %> <small><%= products.length %> منتج</small></h1>
      <form class="sort-form" action="/products">
        <% if (currentCat) { %><input type="hidden" name="c" value="<%= currentCat.slug %>"><% } %>
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <label for="sort">ترتيب:</label>
        <select id="sort" name="sort" data-autosubmit>
          <option value="" <%= !sort ? 'selected' : '' %>>الأحدث</option>
          <option value="cheap" <%= sort === 'cheap' ? 'selected' : '' %>>الأقل سعراً</option>
          <option value="expensive" <%= sort === 'expensive' ? 'selected' : '' %>>الأعلى سعراً</option>
        </select>
      </form>
    </div>
    <% if (products.length) { %>
      <div class="product-grid">
        <% for (const p of products) { %><%- include('../partials/product-card', { p }) %><% } %>
      </div>
    <% } else { %>
      <div class="empty">
        <p>لم نجد منتجات مطابقة.</p>
        <a class="btn btn-dark" href="/products">عرض كل المنتجات</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
