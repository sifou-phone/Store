<%- include('../partials/head') %>

<section class="section">
  <div class="container narrow">
    <div class="empty">
      <h1><%= title %></h1>
      <p><%= locals.message || 'الصفحة التي تبحث عنها غير موجودة أو تم نقلها.' %></p>
      <% if (locals.back) { %>
        <button class="btn btn-dark" type="button" onclick="history.back()">رجوع وتصحيح المعلومات</button>
      <% } else { %>
        <a class="btn btn-dark" href="/">العودة للرئيسية</a>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
