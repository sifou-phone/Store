<%- include('../partials/head') %>

<section class="section">
  <div class="container narrow">
    <div class="empty">
      <h1><%= title %></h1>
      <p><%= locals.message || t('not_found_text') %></p>
      <% if (locals.back) { %>
        <button class="btn btn-dark" type="button" onclick="history.back()"><%= t('back_and_fix') %></button>
      <% } else { %>
        <a class="btn btn-dark" href="/"><%= t('back_home') %></a>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
