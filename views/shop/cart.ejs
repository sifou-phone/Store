<%- include('../partials/head') %>

<section class="section section-tight">
  <div class="container">
    <nav class="crumbs"><a href="/"><%= t('home') %></a><span>/</span><span><%= t('cart') %></span></nav>
    <h1 class="page-title"><%= t('cart_title') %></h1>

    <div class="cart-empty empty" data-cart-empty hidden>
      <%- icon('cart', 'icon-xl') %>
      <p><%= t('cart_empty') %></p>
      <a class="btn btn-dark" href="/products"><%= t('browse_products') %></a>
    </div>

    <div class="cart-layout" data-cart-layout hidden>
      <div class="cart-items" data-cart-items aria-live="polite"></div>
      <div class="cart-checkout">
        <%- include('../partials/order-form', { mode: 'cart', wilayas }) %>
      </div>
    </div>
  </div>
</section>

<template id="cart-item-tpl">
  <div class="cart-item">
    <a class="cart-item-img" data-link><img alt="" width="96" height="96"></a>
    <div class="cart-item-body">
      <a class="cart-item-name" data-link data-name></a>
      <label class="cart-variant" data-variant-wrap><span data-variant-label></span> <select data-variant></select></label>
      <div class="cart-item-row">
        <div class="qty qty-sm">
          <button type="button" class="qty-btn" data-inc aria-label="<%= t('increase') %>"><%- icon('plus') %></button>
          <input type="number" inputmode="numeric" min="1" max="20" data-qty-input>
          <button type="button" class="qty-btn" data-dec aria-label="<%= t('decrease') %>"><%- icon('minus') %></button>
        </div>
        <span class="price" data-line-total></span>
        <button type="button" class="icon-btn" data-remove aria-label="<%= t('remove') %>"><%- icon('trash') %></button>
      </div>
    </div>
  </div>
</template>

<%- include('../partials/footer') %>
