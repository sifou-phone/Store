<%- include('../partials/head') %>

<section class="section section-tight">
  <div class="container">
    <nav class="crumbs">
      <a href="/"><%= t('home') %></a><span>/</span>
      <% if (category) { %><a href="/products?c=<%= category.slug %>"><%= category.name %></a><span>/</span><% } %>
      <span><%= product.name %></span>
    </nav>

    <div class="pdp">
      <div class="gallery" data-gallery>
        <div class="gallery-main">
          <img src="<%= product.image %>" alt="<%= product.name %>" width="700" height="700" data-gallery-main>
          <% if (product.discount) { %><span class="badge badge-sale badge-lg">-<%= product.discount %>%</span><% } %>
        </div>
        <% if (product.imageList.length > 1) { %>
        <div class="thumbs">
          <% product.imageList.forEach((img, i) => { %>
            <button type="button" class="thumb <%= i === 0 ? 'active' : '' %>" data-src="<%= img %>" aria-label="<%= t('image_n', { n: i + 1 }) %>">
              <img src="<%= img %>" alt="" loading="lazy" width="80" height="80">
            </button>
          <% }) %>
        </div>
        <% } %>
      </div>

      <div class="pdp-info">
        <% if (category) { %><a class="eyebrow" href="/products?c=<%= category.slug %>"><%= category.name %></a><% } %>
        <h1><%= product.name %></h1>
        <div class="price-row price-row-lg">
          <span class="price"><%= price(product.price) %></span>
          <% if (product.discount) { %>
            <s class="price-old"><%= price(product.compare_price) %></s>
            <span class="save"><%= t('save_amount', { amount: price(product.compare_price - product.price) }) %></span>
          <% } %>
        </div>
        <% if (product.short_desc) { %><p class="lead"><%= product.short_desc %></p><% } %>

        <ul class="mini-trust">
          <li><%- icon('cash') %><%= t('trust_cod_t') %></li>
          <li><%- icon('truck') %><%= product.free_shipping ? t('free_delivery') : t('delivery_n', { n: wilayaCount }) %></li>
          <li><%- icon('eye') %><%= t('trust_inspect_t') %></li>
        </ul>
        <% if (product.stock != null && product.stock > 0 && product.stock <= 5) { %>
          <p class="stock-warn"><%= t('low_stock', { n: product.stock }) %></p>
        <% } %>

        <%- include('../partials/order-form', { mode: 'single', product, wilayas }) %>
      </div>
    </div>

    <div class="pdp-details">
      <% if (product.featureList.length) { %>
      <div class="panel">
        <h2><%= t('features') %></h2>
        <ul class="features">
          <% for (const f of product.featureList) { %><li><%- icon('check') %><span><%= f %></span></li><% } %>
        </ul>
      </div>
      <% } %>
      <% if (product.description) { %>
      <div class="panel">
        <h2><%= t('description') %></h2>
        <div class="prose"><% for (const para of product.description.split(/\r?\n/).filter(Boolean)) { %><p><%= para %></p><% } %></div>
      </div>
      <% } %>
      <div class="panel">
        <h2><%= t('faq') %></h2>
        <details class="faq" open><summary><%= t('faq1_q') %></summary><p><%= t('faq1_a') %></p></details>
        <details class="faq"><summary><%= t('faq2_q') %></summary><p><%= t('faq2_a') %></p></details>
        <details class="faq"><summary><%= t('faq3_q') %></summary><p><%= t('faq3_a') %></p></details>
        <details class="faq"><summary><%= t('faq4_q') %></summary><p><%= t('faq4_a') %> <a href="/policy"><%= t('read_policy') %></a>.</p></details>
      </div>
    </div>

    <% if (related.length) { %>
    <div class="section-head section-head-spaced"><h2><%= t('related') %></h2></div>
    <div class="product-grid">
      <% for (const p of related) { %><%- include('../partials/product-card', { p }) %><% } %>
    </div>
    <% } %>
  </div>
</section>

<div class="sticky-buy" data-sticky-buy hidden>
  <div>
    <strong><%= price(product.price) %></strong>
    <span><%= product.name %></span>
  </div>
  <a class="btn btn-dark" href="#order"><%= product.inStock ? t('order_now') : t('out_of_stock') %></a>
</div>

<% if (settings.fb_pixel_id) { %>
<script>fbq('track', 'ViewContent', { content_ids: ['<%= product.id %>'], content_type: 'product', value: <%= product.price %>, currency: 'DZD' });</script>
<% } %>

<%- include('../partials/footer') %>
