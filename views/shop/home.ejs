<%- include('../partials/head') %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%= t('hero_eyebrow') %></span>
      <h1><%= t('hero_title_1') %><br><%= t('hero_title_2') %></h1>
      <p><%= t('hero_text', { tagline: loc(settings, 'tagline') }) %></p>
      <div class="hero-actions">
        <a class="btn btn-dark btn-lg" href="/products"><%= t('shop_now') %> <%- icon('arrow', 'flip') %></a>
        <% if (waLink) { %><a class="btn btn-ghost btn-lg" href="<%= waLink %>" target="_blank" rel="noopener"><%- icon('whatsapp') %><%= t('ask_whatsapp') %></a><% } %>
      </div>
      <ul class="hero-points">
        <li><%- icon('check') %><%= t('trust_cod_t') %></li>
        <li><%- icon('check') %><%= t('n_wilayas', { n: wilayaCount }) %></li>
        <li><%- icon('check') %><%= t('trust_inspect_t') %></li>
      </ul>
    </div>
    <div class="hero-art">
      <img src="/img/logo.svg" alt="<%= settings.store_name %>" width="440" height="440">
    </div>
  </div>
</section>

<% if (categories.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><h2><%= t('shop_by_cat') %></h2></div>
    <div class="cat-grid">
      <% for (const c of categories) { %>
        <a class="cat-tile" href="/products?c=<%= c.slug %>"><span><%= c.name %></span><%- icon('arrow', 'flip') %></a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (featured.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2><%= t('best_sellers') %></h2>
      <a class="link" href="/products"><%= t('view_all') %> <%- icon('arrow', 'flip') %></a>
    </div>
    <div class="product-grid">
      <% for (const p of featured) { %><%- include('../partials/product-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="steps">
      <h2><%= t('how_title') %></h2>
      <ol>
        <li><span class="step-n">1</span><div><strong><%= t('step1_t') %></strong><p><%= t('step1_d') %></p></div></li>
        <li><span class="step-n">2</span><div><strong><%= t('step2_t') %></strong><p><%= t('step2_d') %></p></div></li>
        <li><span class="step-n">3</span><div><strong><%= t('step3_t') %></strong><p><%= t('step3_d') %></p></div></li>
      </ol>
    </div>
  </div>
</section>

<% if (latest.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2><%= t('new_arrivals') %></h2>
      <a class="link" href="/products"><%= t('view_all') %> <%- icon('arrow', 'flip') %></a>
    </div>
    <div class="product-grid">
      <% for (const p of latest) { %><%- include('../partials/product-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } else { %>
<section class="section"><div class="container empty"><%= t('no_products_yet') %></div></section>
<% } %>

<%- include('../partials/footer') %>
