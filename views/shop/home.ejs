<%- include('../partials/head') %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">هواتف • سماعات • شواحن • إكسسوارات</span>
      <h1>كل ما يحتاجه هاتفك،<br>في مكان واحد.</h1>
      <p><%= settings.tagline %>. اطلب الآن وادفع عند الاستلام، مع توصيل سريع إلى باب منزلك.</p>
      <div class="hero-actions">
        <a class="btn btn-dark btn-lg" href="/products">تسوّق الآن <%- icon('arrow') %></a>
        <% if (waLink) { %><a class="btn btn-ghost btn-lg" href="<%= waLink %>" target="_blank" rel="noopener"><%- icon('whatsapp') %>اسألنا على واتساب</a><% } %>
      </div>
      <ul class="hero-points">
        <li><%- icon('check') %>الدفع عند الاستلام</li>
        <li><%- icon('check') %>58 ولاية</li>
        <li><%- icon('check') %>افحص قبل الدفع</li>
      </ul>
    </div>
    <div class="hero-art">
      <img src="/img/logo.svg" alt="<%= settings.store_name %>" width="440" height="440">
    </div>
  </div>
</section>

<% if (categories.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><h2>تسوّق حسب القسم</h2></div>
    <div class="cat-grid">
      <% for (const c of categories) { %>
        <a class="cat-tile" href="/products?c=<%= c.slug %>"><span><%= c.name %></span><%- icon('arrow') %></a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (featured.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>الأكثر طلباً</h2>
      <a class="link" href="/products">عرض الكل <%- icon('arrow') %></a>
    </div>
    <div class="product-grid">
      <% for (const p of featured) { %><%- include('../partials/product-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="steps">
      <h2>كيف تطلب؟</h2>
      <ol>
        <li><span class="step-n">1</span><div><strong>اختر منتجك</strong><p>تصفح المنتجات واملأ استمارة الطلب في أقل من دقيقة.</p></div></li>
        <li><span class="step-n">2</span><div><strong>نتصل بك للتأكيد</strong><p>يتصل بك فريقنا لتأكيد الطلب والعنوان.</p></div></li>
        <li><span class="step-n">3</span><div><strong>استلم وادفع</strong><p>افحص المنتج عند الاستلام ثم ادفع نقداً.</p></div></li>
      </ol>
    </div>
  </div>
</section>

<% if (latest.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>وصل حديثاً</h2>
      <a class="link" href="/products">عرض الكل <%- icon('arrow') %></a>
    </div>
    <div class="product-grid">
      <% for (const p of latest) { %><%- include('../partials/product-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } else { %>
<section class="section"><div class="container empty">لا توجد منتجات بعد.</div></section>
<% } %>

<%- include('../partials/footer') %>
