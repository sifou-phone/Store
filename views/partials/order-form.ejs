<%
  // mode: 'single' (landing page, one product) or 'cart' (checkout of the cart)
  const single = mode === 'single';
%>
<form class="order-form" id="order" method="post" action="/order" novalidate
  data-order-form data-mode="<%= mode %>"
  <% if (single) { %>data-product-id="<%= product.id %>" data-price="<%= product.price %>" data-free-shipping="<%= product.free_shipping %>" data-stock="<%= product.stock ?? '' %>"<% } %>>
  <div class="order-head">
    <h2><%= single ? 'اطلب الآن' : 'معلومات التوصيل' %></h2>
    <span class="cod-pill"><%- icon('cash') %>الدفع عند الاستلام</span>
  </div>

  <% if (single) { %>
    <input type="hidden" name="product_id" value="<%= product.id %>">
    <% if (product.variantList.length) { %>
    <fieldset class="field">
      <legend><%= product.variant_label %></legend>
      <div class="chips">
        <% product.variantList.forEach((v, i) => { %>
          <label class="chip"><input type="radio" name="variant" value="<%= v %>" <%= i === 0 ? 'checked' : '' %>><span><%= v %></span></label>
        <% }) %>
      </div>
    </fieldset>
    <% } %>
    <div class="field">
      <label for="qty">الكمية</label>
      <div class="qty" data-qty>
        <button type="button" class="qty-btn" data-qty-step="1" aria-label="زيادة"><%- icon('plus') %></button>
        <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max="<%= product.stock != null ? Math.min(product.stock, 20) : 20 %>" value="1">
        <button type="button" class="qty-btn" data-qty-step="-1" aria-label="إنقاص"><%- icon('minus') %></button>
      </div>
    </div>
  <% } %>

  <div class="grid-2">
    <div class="field">
      <label for="customer_name">الاسم الكامل</label>
      <input id="customer_name" name="customer_name" autocomplete="name" required maxlength="80" placeholder="الاسم واللقب">
      <small class="err" data-err="customer_name"></small>
    </div>
    <div class="field">
      <label for="phone">رقم الهاتف</label>
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="20" placeholder="05 55 12 34 56" dir="ltr">
      <small class="err" data-err="phone"></small>
    </div>
    <div class="field">
      <label for="wilaya">الولاية</label>
      <select id="wilaya" name="wilaya" required>
        <option value="">اختر الولاية</option>
        <% for (const w of wilayas) { %>
          <option value="<%= w.code %>"><%= String(w.code).padStart(2, '0') %> - <%= w.name_ar %></option>
        <% } %>
      </select>
      <small class="err" data-err="wilaya"></small>
    </div>
    <div class="field">
      <label for="commune">البلدية</label>
      <input id="commune" name="commune" required maxlength="80" placeholder="اسم البلدية">
      <small class="err" data-err="commune"></small>
    </div>
  </div>

  <fieldset class="field">
    <legend>طريقة التوصيل</legend>
    <div class="delivery-options">
      <label class="delivery-opt"><input type="radio" name="delivery_type" value="home" checked>
        <span><%- icon('home') %><b>توصيل للمنزل</b><em data-ship-price="home">—</em></span></label>
      <label class="delivery-opt"><input type="radio" name="delivery_type" value="desk">
        <span><%- icon('box') %><b>مكتب التوصيل</b><em data-ship-price="desk">—</em></span></label>
    </div>
  </fieldset>

  <div class="field" data-address-field>
    <label for="address">العنوان</label>
    <input id="address" name="address" autocomplete="street-address" maxlength="200" placeholder="الحي، الشارع، رقم المنزل">
    <small class="err" data-err="address"></small>
  </div>

  <details class="notes">
    <summary>إضافة ملاحظة (اختياري)</summary>
    <textarea name="notes" rows="2" maxlength="500" placeholder="مثال: موديل الهاتف، وقت مناسب للاتصال..."></textarea>
  </details>

  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>

  <div class="summary">
    <div><span>المنتجات</span><span data-sum="subtotal">—</span></div>
    <div><span>التوصيل</span><span data-sum="shipping">اختر الولاية</span></div>
    <div class="summary-total"><span>المجموع</span><span data-sum="total">—</span></div>
  </div>

  <div class="form-error" data-err="form" role="alert" hidden></div>

  <% if (single && !product.inStock) { %>
    <button class="btn btn-dark btn-block btn-lg" type="button" disabled>نفد المخزون</button>
  <% } else { %>
    <button class="btn btn-dark btn-block btn-lg" type="submit" data-submit>
      <%- icon('check') %><span>تأكيد الطلب</span>
    </button>
    <% if (single) { %>
      <button class="btn btn-ghost btn-block" type="button" data-add-to-cart><%- icon('cart') %>أضف إلى السلة</button>
    <% } %>
  <% } %>
  <p class="form-note">لن تدفع أي شيء الآن. سنتصل بك لتأكيد الطلب، وتدفع عند استلامه.</p>
</form>
<script type="application/json" id="wilayas-data"><%- json(wilayas) %></script>
